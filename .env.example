# 브라우저가 호출할 API 경로. 개발 중에는 vite 프록시(/api)를 그대로 쓴다.
# 배포 시 같은 오리진이 아니면 절대 주소로 바꾼다. 예: https://api.dvi-ind.com/jagigo
VITE_API_BASE_URL=/api

# vite dev 프록시가 /api 를 넘길 실제 백엔드 주소 (개발 전용)
VITE_API_PROXY_TARGET=https://api.dvi-ind.com/jagigo

# 개발 중 로그인 화면을 보고 싶을 때만. 콜백은 운영 도메인으로 돌아가므로 화면 확인용이다
# VITE_FORCE_LOGIN=true

# 로컬에서 로그인된 상태로 자료까지 보고 싶을 때. 운영에서 로그인해 받은 토큰을 붙여 넣는다
# (브라우저 localStorage 의 jagigo.token). 개발 빌드에서만 읽는다
# VITE_DEV_TOKEN=

# --- 브라우저 푸시 알림 (Firebase 프로젝트: qacflow-37ace) ---
# 값을 적지 않으면 src/lib/push.ts 의 기본값을 쓴다. 그 값들은 감출 수 있는 것이 아니라
# (어차피 브라우저 번들에 실려 나간다) 코드에 두었다 — 배포처에 따로 넣지 않아도 알림이 온다.
# 다른 Firebase 프로젝트로 옮길 때만 아래를 채운다.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_VAPID_KEY=
