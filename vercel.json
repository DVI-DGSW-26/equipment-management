{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/assets", "destination": "/", "permanent": false },
    { "source": "/assets/", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://api.dvi-ind.com/jagigo/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
